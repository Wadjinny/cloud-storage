# Copy to .env and fill in local values. Never commit .env.

# Auth / bootstrap
SESSION_SECRET=change-me
INIT_USERNAME=
INIT_PASSPHRASE=

# Google OAuth (Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:1234
GOOGLE_REDIRECT_URI=http://localhost:1234/api/auth/google/callback

# Optional extra CORS origins (comma-separated)
# CORS_ALLOW_ORIGINS=

# Paths
# DATA_DIR=
# DB_PATH=

# Placement
SHARD_FOLDER_NAME=cloud-storage-vault
SHARD_BALANCE_SLACK=0.2
# STORAGE_FULL_RATIO=0.8

# Upload / download concurrency
UPLOAD_QUEUE_DEPTH=0
SHARD_UPLOAD_CONCURRENCY=1
MEGA_ACCOUNT_UPLOAD_CONCURRENCY=1
GDRIVE_ACCOUNT_UPLOAD_CONCURRENCY=1
DOWNLOAD_QUEUE_DEPTH=4
SHARD_DOWNLOAD_CONCURRENCY=1
MEGA_ACCOUNT_DOWNLOAD_CONCURRENCY=1
GDRIVE_ACCOUNT_DOWNLOAD_CONCURRENCY=1

# Zip downloads
ZIP_PREFETCH_FILES=3
ZIP_PREFETCH_MAX_FILE_BYTES=33554432

# Other tunables
HEALTH_CHECK_CONCURRENCY=8
# DELETE_CONCURRENCY=8
# MEGA_SESSION_TTL_SECONDS=600
# PROVIDER_OP_TIMEOUT=120
# PROVIDER_OP_RETRIES=3
PREVIEW_MAX_MB=5
VIDEO_PREVIEW_MAX_MB=100
HISTORY_RETENTION_DAYS=30
# UVICORN_RELOAD=1

# Optional live tests (pytest -m live)
# CLOUD_STORAGE_TEST_MEGA_EMAIL=
# CLOUD_STORAGE_TEST_MEGA_PASSWORD=
# CLOUD_STORAGE_TEST_MEGA_MFA=
# CLOUD_STORAGE_VAULT_PASSPHRASE=
# CLOUD_STORAGE_TEST_GDRIVE_REFRESH_TOKEN=
# CLOUD_STORAGE_TEST_GDRIVE_TOKEN=
# CLOUD_STORAGE_TEST_GDRIVE_LABEL=
